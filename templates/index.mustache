    <h2>Curso de</h2>
    <h3>{{coursename}}</h3>
</div>

<div class="row mt-4 coursecontent">
    <div class="col-sm-12 col-md-9">
        {{#summary}}
            <h3>Sobre o curso</h3>
            <div class="coursesummary">
                {{{.}}}
            </div>
        {{/summary}}

        {{#syllabus}}
            <h3 class="mt-4">Conteúdo detalhado</h3>
            <div class="coursesyllabus mb-4">
                {{{.}}}
            </div>
        {{/syllabus}}

        {{#partnersimg}}
            <h3 class="mt-4">Este curso foi feito em parceria com:</h3>

            <img src="{{partnersimg}}" alt="Parceiros do curso">
        {{/partnersimg}}
    </div>
    <div class="col-sm-12 col-md-3 rightside">
        <div class="inner-content">
            {{#duration}}
                <div class="d-flex">
                    <img src="{{config.wwwroot}}/local/course/pix/duration.png" alt="Carga horária">
                    <div class="ml-2">
                        <h4 class="mt-1">Carga horária</h4>
                        <p>{{.}}</p>
                    </div>
                </div>
            {{/duration}}
            {{#audience}}
                <div class="d-flex">
                    <img src="{{config.wwwroot}}/local/course/pix/audience.png" alt="Público-alvo">
                    <div class="ml-2">
                        <h4 class="mt-1">Público-alvo</h4>
                        <p>{{.}}</p>
                    </div>
                </div>
            {{/audience}}
            {{#hascustomfields}}
                <div class="p-2">
                    <h5 class="d-flex align-items-center gap-x-3 font-semibold">
                        <span class="flex-shrink-0 text-xs">{{#str}}coursedetails, local_course{{/str}}</span>
                        <span class="h-px w-full bg-grey-800"></span>
                    </h5>
                    {{#customfields}}
                        {{#hasvalue}}
                            <h5 class="mb-0 font-light">{{name}}</h5>
                            <p>{{{value}}}</p>
                        {{/hasvalue}}
                    {{/customfields}}
                </div>
            {{/hascustomfields}}

            <div class="enrolbuttons">
                {{{ enrolbuttons }}}
            </div>
        </div>
    </div>
</div>
